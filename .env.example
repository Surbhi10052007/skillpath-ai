# ─────────────────────────────────────────────────────────────
# SkillPath AI — environment variables
#
# Copy this file to `.env` (shared defaults) or `.env.local`
# (per-developer overrides, never committed):
#
#   cp .env.example .env.local
#
# Next.js loads .env.local with higher priority than .env.
# ─────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string (Drizzle ORM, src/db/index.ts)
#
# Where the value comes from:
#   • Local / sandbox: the platform provides a PostgreSQL instance at
#     postgresql://postgres:postgres@127.0.0.1:5432/app_db
#   • Neon:     Dashboard → Connection Details → Connection string (psql)
#   • Supabase: Project Settings → Database → Connection string → URI
#   • Railway:  Postgres service → Connect → Postgres Connection URL
#   • Vercel:   Storage → Postgres → .env.local tab
#
# Managed providers require SSL; append `?sslmode=require` if needed.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# REQUIRED IN PRODUCTION — HS256 secret used to sign auth JWTs
# (src/lib/auth/jwt.ts). Development falls back to a placeholder,
# which is unsafe in production.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string

# OPTIONAL — point the client at an external API (e.g. FastAPI) instead
# of the built-in Next.js route handlers. Only NEXT_PUBLIC_* variables
# are exposed to the browser.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ─────────────────────────────────────────────────────────────
# Public app URL — used to build links inside emails.
# No trailing slash. Never hardcode localhost in production.
#   Development: http://localhost:3000
#   Production:  https://skillpath-ai-ub24.vercel.app
# Falls back to the incoming request origin if unset.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Password reset email delivery (Resend — https://resend.com)
#
# 1. Create an API key: Resend → API Keys → Create API Key
#    (Sending access is enough.)
# 2. Verify a domain: Resend → Domains → Add Domain, add the DNS
#    records, wait for "Verified".
# 3. EMAIL_FROM must be an address on that verified domain,
#    e.g. "SkillPath <no-reply@yourdomain.com>".
#    Resend's onboarding@resend.dev works for testing only and
#    can only send to your own Resend account email.
#
# When these are absent, /api/auth/forgot-password returns 503
# instead of silently pretending an email was sent.
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=SkillPath <no-reply@yourdomain.com>

# OPTIONAL — override the Resend API endpoint (self-hosted proxy or
# local stub during testing). Defaults to https://api.resend.com/emails
# RESEND_API_URL=http://localhost:4001/emails
